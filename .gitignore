/target
**/*.rs.bk
# Cargo.lock is committed from F0.REPO.01 onward: this workspace ships binaries, and reproducible release
# builds (plan DEP.BLD.05, DEP.SUP.07) and cargo-auditable manifests are meaningless
# without a fixed resolved dependency set.

# Build artefacts
/dist
*.pdb
*.sys
*.obj
*.o

# Local state — never commit forensic data or keys
*.wal
*.parquet
*.duckdb
/local
.aisme/
*.pem
*.key
*.pfx
*.cer

# Mobile
/mobile/android/build
/mobile/android/.gradle
/mobile/ios/build
*.xcuserstate
DerivedData/

# UI
/ui/node_modules
/ui/dist

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/
*:Zone.Identifier
