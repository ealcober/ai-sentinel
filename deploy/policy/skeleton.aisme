# F2's policy — the walking skeleton's three rules and its write scope.
#
# A file, not a string in a test: the gate compiles what an operator would edit,
# through `aisme_core::policy::compile_with`, and publishes the result. A
# skeleton that published a hand-built `CompiledPolicy` would prove nothing
# about the pipeline it exists to prove.
#
# `${workspace}` and `${home}` are bound by `aisme-agentd` when a session
# registers (`F2.WS.11`): the workspace from the scope that session declared,
# the home from the peer's uid. Nothing here hard-codes a path that only holds
# on one machine, and nothing here is bound to a value the supervised process
# chose.

[session.defaults]
# The shipped values (Annex B). Written out rather than left implicit, because
# this file is also the worked example an operator copies. `profile` is the
# grammar's switch: "default" or "strict".
learning_mode_days = 7
grant_ttl_days = 30
profile = "default"

# 1. The credential store is denied outright. SYSTEM_CONFIG, FILELESS_EXECUTE
#    and SELF_PROTECTION cannot be prompted or suppressed at all (`I-05`);
#    CREDENTIALS can, which is why this rule states the verdict rather than
#    relying on a group default.
[[rule]]
id = "deny-shadow"
group = "CREDENTIALS"
match = { path_under = "/etc/shadow" }
verdict = "deny"

# 2. Cloud credentials are the escalate class: the syscall is held and someone
#    is asked. This is the rule `F2.WS.05` traps on and `F2.WS.06` answers.
#
#    **Not `~/.aws/**`, and the reason is measured.** `~` is a shell expansion,
#    not a path: the supervisor evaluates what the kernel was asked for, which
#    is already `/home/<user>/.aws/credentials`. A rule spelled with a tilde
#    matches nothing any process ever opens — measured on 2026-09-15, where
#    `cat ~/.aws/credentials` under this policy read the file with **0 asked**
#    and the escalate path was never exercised. A rule that cannot fire is
#    worse than no rule, because the gate that tests it still passes.
#
#    `${home}` is bound per session by `aisme-agentd` from the **peer's uid**,
#    which the kernel writes into `SO_PEERCRED` and no client can claim. It is
#    not read from anyone's `HOME`: a session that named its own home would aim
#    this rule at an empty directory and be allowed everywhere it was meant to
#    hold. One `**` is the compiler's budget (`MAX_DOUBLE_STAR`), and this rule
#    spends it on the subtree rather than on finding the home.
[[rule]]
id = "escalate-aws"
group = "CREDENTIALS"
match = { path_glob = "${home}/.aws/**" }
verdict = "escalate"

# 3. The write scope (`F2.WS.11`): a write outside the session's declared
#    workspace is denied in kernel by one Landlock ruleset applied before
#    `exec`. The rule is stated here so the policy — not the code — is what
#    says where the boundary is.
#
#    **`${workspace}`, with braces.** `$workspace` is not a variable in this
#    grammar, it is a literal — so the rule used to match a directory named
#    `$workspace`, which no machine has, while the daemon still reported three
#    rules in force. A rule that cannot fire is worse than no rule.
[[rule]]
id = "scope-writes"
group = "FILES_OUTSIDE_WORKSPACE"
match = { path_under = "${workspace}" }
verdict = "allow"

# Everything not named above is allowed: §B.10's default verdict, stated so a
# reader does not have to infer it from an absence.
