#
# The unprivileged half (F1.RT.07). agentd runs the hot loop with no
# capabilities at all: the programs are already attached by the loader, and
# the session cgroup subtree is *delegated* to this unit, so freezing a scope
# for T2 adjudication needs no privilege — writing cgroup.freeze inside a
# delegated subtree is an ordinary write by its owner.
[Unit]
Description=AISME agent daemon (hot path)
Documentation=https://github.com/ealcober/aisme
After=aisme-loaderd.service
Requires=aisme-loaderd.service

[Service]
# Type=exec, not notify: the daemon sends no READY=1, and a notify unit whose
# process never does is held in `activating` until TimeoutStartSec and then
# failed — taking aisme-loaderd's Requires= with it. notify becomes correct once
# the hot loop has a readiness point to report, which is a task and not a side
# effect of writing this line.
Type=exec
ExecStart=/usr/lib/aisme/aisme-agentd --run /var/lib/aisme/wal --serve-ipc /run/aisme/agentd.sock
User=aisme
Group=aisme

# Delegation is what makes the privilege split work for T2: systemd hands
# this unit its own cgroup subtree, and the daemon may create and freeze
# cgroups inside it as its own user (systemd.resource-control(5)).
Delegate=yes
DelegateSubgroup=sessions

# No capabilities, and no way to gain any.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
StateDirectory=aisme
RuntimeDirectory=aisme
RuntimeDirectoryMode=0750

# H-03: the budget is the product. The limit is above the invariant so a
# breach is a report, not an OOM kill during a soak.
MemoryMax=128M
MemoryHigh=64M

[Install]
WantedBy=multi-user.target
